{
    "name": "vosulay-windows",
    "version": "0.1.0",
    "description": "Windows in-game overlay host for vosulay",
    "private": true,
    "license": "MIT",
    "main": "./out/main/index.js",
    "scripts": {
        "build": "electron-vite build",
        "test": "tsx --test test/**/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.node.json",
        "verify:package": "node scripts/verify-package.mjs",
        "dist:win": "npm run build && electron-builder --win --publish never && npm run verify:package"
    },
    "dependencies": {
        "@asdf-overlay/core": "1.2.5",
        "@asdf-overlay/electron": "1.2.5",
        "@paymoapp/active-window": "2.1.4",
        "cheerio": "^1.1.2",
        "find-process": "^2.1.1",
        "mime-types": "^3.0.1"
    },
    "devDependencies": {
        "@electron/asar": "^3.4.1",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^24.10.4",
        "electron": "40.10.6",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vite": "^7.3.1"
    },
    "build": {
        "appId": "dev.vosu.vosulay",
        "productName": "vosulay",
        "asar": true,
        "asarUnpack": [
            "node_modules/@asdf-overlay/core/**/*",
            "node_modules/@asdf-overlay/electron/**/*",
            "node_modules/@paymoapp/active-window/build/Release/PaymoActiveWindow.node"
        ],
        "files": [
            "out/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../assets",
                "to": "assets",
                "filter": [
                    "manager.html",
                    "manager.css",
                    "manager.js"
                ]
            }
        ],
        "electronLanguages": [
            "en-US"
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "artifactName": "vosulay-${version}-setup.${ext}"
        },
        "portable": {
            "artifactName": "vosulay-${version}-portable.${ext}"
        }
    },
    "engines": {
        "node": ">=22"
    },
    "os": [
        "win32"
    ]
}
