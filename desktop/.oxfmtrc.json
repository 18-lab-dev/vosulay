{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": false,
    "semi": true,
    "trailingComma": "all",
    "insertFinalNewline": true,
    "endOfLine": "lf",
    "bracketSpacing": true,
    "arrowParens": "always",
    "ignorePatterns": [
        "node_modules/**",
        "out/**",
        "dist/**",
        "build/**",
        "tools/oxlint/anti-slop/**"
    ]
}
