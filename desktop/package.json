{
    "name": "vosulay",
    "version": "0.2.0",
    "description": "Cross-platform in-game overlay host for vosulay",
    "desktopName": "vosulay.desktop",
    "private": true,
    "license": "MIT",
    "packageManager": "bun@1.3.14",
    "main": "./out/main/index.js",
    "scripts": {
        "build": "electron-vite build",
        "test": "tsx --test test/**/*.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.node.json",
        "verify:package": "node scripts/verify-package.mjs",
        "dist:win": "bun run build && electron-builder --win --publish never && bun run verify:package -- win",
        "stage:native": "node scripts/stage-native.mjs",
        "dist:linux": "bun run stage:native && bun run build && electron-builder --linux --publish never && bun run verify:package -- linux"
    },
    "dependencies": {
        "cheerio": "^1.1.2",
        "find-process": "^2.1.1",
        "mime-types": "^3.0.1"
    },
    "optionalDependencies": {
        "@asdf-overlay/core": "1.2.5",
        "@asdf-overlay/electron": "1.2.5",
        "@paymoapp/active-window": "2.1.4"
    },
    "devDependencies": {
        "@electron/asar": "^3.4.1",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^24.10.4",
        "electron": "40.10.6",
        "electron-builder": "^26.4.0",
        "electron-vite": "^5.0.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vite": "^7.3.1"
    },
    "trustedDependencies": [
        "electron",
        "electron-winstaller",
        "esbuild"
    ],
    "build": {
        "appId": "dev.vosu.vosulay",
        "productName": "vosulay",
        "asar": true,
        "files": [
            "out/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../assets",
                "to": "assets",
                "filter": [
                    "manager.html",
                    "manager.css",
                    "manager.js"
                ]
            }
        ],
        "electronLanguages": [
            "en-US"
        ],
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "asarUnpack": [
                "node_modules/@asdf-overlay/core/**/*",
                "node_modules/@asdf-overlay/electron/**/*",
                "node_modules/@paymoapp/active-window/build/Release/PaymoActiveWindow.node"
            ]
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "files": [
                "out/**/*",
                "package.json",
                "!node_modules/@asdf-overlay/core/**/*",
                "!node_modules/@asdf-overlay/electron/**/*",
                "!node_modules/@paymoapp/active-window/**/*"
            ],
            "extraResources": [
                {
                    "from": "build/native",
                    "to": "native",
                    "filter": [
                        "**/*"
                    ]
                }
            ],
            "artifactName": "vosulay-${version}-x64.${ext}",
            "icon": "../assets/branding/vosulay-app-icon.png",
            "syncDesktopName": true,
            "category": "Utility"
        },
        "nsis": {
            "artifactName": "vosulay-${version}-setup.${ext}"
        },
        "portable": {
            "artifactName": "vosulay-${version}-portable.${ext}"
        }
    },
    "engines": {
        "node": ">=22"
    }
}
